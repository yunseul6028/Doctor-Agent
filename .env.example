# Copy this file to .env and use it (.env is excluded from git and the submission ZIP)
# Settings shared by every role (doctor, patient, judge). Override per role with DOCTOR_LLM_* / PATIENT_LLM_* / JUDGE_LLM_*.

# ── Current: Gemini (temporary, until the competition GPT API arrives) ──
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key
LLM_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4096

# ── Later: switch only the doctor agent to the competition model (uncomment the 3 lines below) ──
# DOCTOR_LLM_BASE_URL=<competition API address>
# DOCTOR_LLM_API_KEY=<competition API token>
# DOCTOR_LLM_MODEL=openai/gpt-oss-20b
