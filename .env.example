# Copy this file to .env and use it (.env is excluded from git). No key values here.
# Every role reads <ROLE>_LLM_* first and falls back to the shared LLM_* (roles: DOCTOR, PATIENT, JUDGE).
# Code defaults (src/doctor_agent/config.py) need no .env: dummy / keyword / smoke runs work without one.

# ── Shared settings = virtual patient and judge: Gemini Flash (cheaper), OpenAI-compatible Gemini endpoint ──
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key
LLM_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4096

# ── Doctor agent: Gemini Pro (pinned preview name, not a -latest alias); same endpoint and key as above ──
DOCTOR_LLM_MODEL=gemini-3.1-pro-preview
# Thinking model: effort is tunable (low | medium | high; "none" = parameter not sent, provider default).
# low keeps cost and latency down; try medium/high in experiments.
DOCTOR_LLM_REASONING_EFFORT=low
# Reasoning tokens count toward max_tokens, so leave room for thinking on top of the action JSON (~300 tokens).
DOCTOR_LLM_MAX_TOKENS=8192
# finish_reason=length with no answer -> one retry with max_tokens x 2 (capped here) and effort low
DOCTOR_LLM_MAX_TOKENS_CAP=16384
# per-request timeout in seconds (assumption: Pro thinking calls can exceed a minute; code default 180)
DOCTOR_LLM_TIMEOUT=180

# ── Runtime knobs (optional; see docs/architecture.md "Runtime") ──
# AGENT_CASE_TIME_BUDGET_S=0            # per-case wall-clock budget, 0 = unlimited
# AGENT_DEGRADE_AT_FRAC=0.6             # degrade (no review, short hints, low effort) past this fraction
# AGENT_FINAL_RESERVE_S=45              # force the final diagnosis when this many seconds remain
# AGENT_SUBAGENT_TIME_FACTOR=3          # skip a sub-agent call when time left < factor x recent main-call latency
# AGENT_SUBAGENT_REASONING_EFFORT=low   # reasoning effort of sub-agent calls
# AGENT_MAX_VIEW_CHARS=12000            # prompt view cap in characters, 0 = unlimited
# DOCTOR_LLM_STRUCTURED_OUTPUT=off      # off | json_schema | guided_json (vLLM)
# DOCTOR_ENV=local                      # run.py case source (see src/doctor_agent/env/factory.py)

# ── Experiment runner presets (eval/experiment.py --doctor-endpoint ...) ──
# gemini: doctor GEMINI_DOCTOR_LLM_MODEL (default gemini-3.1-pro-preview), patient/judge GEMINI_PATIENT_LLM_MODEL /
#         GEMINI_JUDGE_LLM_MODEL (default gemini-3.6-flash); endpoint/key GEMINI_LLM_BASE_URL / GEMINI_LLM_API_KEY
#         (fall back to LLM_*). An explicit PATIENT_LLM_MODEL / JUDGE_LLM_MODEL is kept.
# local (optional, not the default): any OpenAI-compatible gpt-oss-20b server (Ollama, vLLM), doctor only
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1  LOCAL_LLM_MODEL=gpt-oss:20b  LOCAL_LLM_API_KEY=EMPTY
# Cost guard: no built-in prices. Set the doctor model's price yourself (KRW per 1M tokens), else "price unknown".
# EXPERIMENT_PRICE_IN_PER_M=
# EXPERIMENT_PRICE_OUT_PER_M=
