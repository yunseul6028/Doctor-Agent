# Copy this file to .env and use it (.env is excluded from git and the submission ZIP)
# Settings shared by every role (doctor, patient, judge). Override per role with DOCTOR_LLM_* / PATIENT_LLM_* / JUDGE_LLM_*.

# ── Current: Gemini (temporary, until the competition GPT API arrives) ──
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-key
LLM_MODEL=gemini-3.6-flash
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=4096

# ── Later: switch only the doctor agent to the competition model (uncomment the 3 lines below) ──
# DOCTOR_LLM_BASE_URL=<competition API address>
# DOCTOR_LLM_API_KEY=<competition API token>
# DOCTOR_LLM_MODEL=openai/gpt-oss-20b

# ── Runtime knobs (optional; see docs/architecture.md "Runtime") ──
# AGENT_CASE_TIME_BUDGET_S=0            # per-case wall-clock budget, 0 = unlimited
# AGENT_DEGRADE_AT_FRAC=0.6             # degrade (no review, short hints, low effort) past this fraction
# AGENT_FINAL_RESERVE_S=45              # force the final diagnosis when this many seconds remain
# AGENT_MAX_VIEW_CHARS=12000            # prompt view cap in characters, 0 = unlimited
# DOCTOR_LLM_STRUCTURED_OUTPUT=off      # off | json_schema | guided_json (vLLM)
# DOCTOR_LLM_MAX_TOKENS_CAP=8192        # cap for the finish_reason=length retry
# DOCTOR_ENV=local                      # run.py case source: local | official

# ── Experiment runner presets (eval/experiment.py --doctor-endpoint ...) ──
# COMPETITION_LLM_BASE_URL=<competition API address>
# COMPETITION_LLM_API_KEY=<competition API token>
# COMPETITION_LLM_MODEL=openai/gpt-oss-20b
# GEMINI_LLM_BASE_URL / GEMINI_LLM_API_KEY / GEMINI_LLM_MODEL   (falls back to LLM_*)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1  LOCAL_LLM_MODEL=gpt-oss:20b
# EXPERIMENT_PRICE_IN_PER_M / EXPERIMENT_PRICE_OUT_PER_M   (KRW per 1M tokens, for the cost guard)
